# LLM configuration for the explanation writer.
# Optional: without a valid key the system uses SHAP-based fallback templates
# and still produces the full PDF report.

LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini

# Any OpenAI-compatible chat completions endpoint, for example:
#   OpenAI:     https://api.openai.com/v1
#   DashScope:  https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.openai.com/v1

# Request timeout in seconds (default 30)
LLM_TIMEOUT=30

# ---- Backend API configuration ----

# Database (SQLite locally; PostgreSQL/Supabase URL for deployment)
# DATABASE_URL=sqlite:///credit_scoring.db

# Comma-separated allowed browser origins (CORS)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Simulated OTP settings
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5

# Demo mode: return the simulated OTP in API responses so the flow can be
# demonstrated without an SMS gateway. Set to false in production.
# DEV_RETURN_OTP=true
